# PARALLAX — environment template. Copy to `.env.local` and fill in.
# NOTHING here is public: every value is server-side only (no NEXT_PUBLIC_ prefix),
# so keys never reach the browser. The browser only ever gets short-lived
# ephemeral Gemini tokens minted from GEMINI_API_KEY.

# --- KeeperHub (execution + automation engine) ---------------------------------
# Controls REAL on-chain execution via the KeeperHub MCP. Server-side ONLY.
KEEPERHUB_API_KEY=kh_your_key_here
# Optional overrides (sensible defaults baked in):
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp
KEEPERHUB_INTEGRATION_ID=
KEEPERHUB_WALLET=

# --- Google Gemini (voice + intent) --------------------------------------------
# Multimodal + Live (native audio) API key. Server-side; browser gets ephemeral tokens.
GEMINI_API_KEY=your_gemini_key_here
# Optional model overrides:
GEMINI_MODEL=gemini-flash-latest
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest

# --- MetaMask Delegation Toolkit (bounded execution) ---------------------------
# Smart-account owner (the Ledger software stand-in for the delegation base path).
MM_OWNER_PK=0xyour_owner_private_key
# Agent delegate + gas relayer EOA (redeems delegations, pays gas).
MM_RELAYER_PK=0xyour_relayer_private_key
# Real Ledger Flex address that signs the custom mandate (public address, not a key).
MM_FLEX_OWNER=0xyour_ledger_flex_address

# --- Chain RPC -----------------------------------------------------------------
# Public Sepolia RPC works; set your own for reliability.
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
